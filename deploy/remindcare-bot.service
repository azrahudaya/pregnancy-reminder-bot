[Unit]
Description=pregnancy-reminder-bot WhatsApp Bot
Documentation=file:/opt/remindcare/README.md
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
# Ganti User dan WorkingDirectory sesuai mesin Anda.
User=ubuntu
WorkingDirectory=/opt/remindcare
# File .env dibaca kalau ada. Isi dari .env.example.
EnvironmentFile=-/opt/remindcare/.env
Environment=NODE_ENV=production
ExecStart=/usr/bin/node index.js
# Bot mengirim pesan ke pasien: selalu hidupkan lagi kalau mati, tapi jangan berputar
# terlalu cepat saat sesi WhatsApp bermasalah (pemindaian QR berulang itu sinyal).
Restart=always
RestartSec=30
# Bot mengirim pesan dan menyimpan data kesehatan, jadi haknya dipersempit. Chromium perlu
# menulis ke profil Puppeteer dan direktori sesi WhatsApp, itulah bagian yang dibuka.
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
MemoryMax=1500M
# Tanda minus di depan path berarti abaikan kalau direktorinya belum ada.
ReadWritePaths=-/opt/remindcare/data -/opt/remindcare/.wwebjs_auth -/opt/remindcare/.wwebjs_cache -/opt/remindcare/.config -/home/remindcare/.cache -/home/remindcare/.config
# Beri waktu shutdown rapi (menutup DB dan melepas lock instance).
KillSignal=SIGTERM
TimeoutStopSec=60
StandardOutput=journal
StandardError=journal
SyslogIdentifier=remindcare

[Install]
WantedBy=multi-user.target