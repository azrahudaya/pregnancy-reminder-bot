[Unit]
Description=Backup harian database pregnancy-reminder-bot
After=remindcare-bot.service

[Service]
Type=oneshot
User=ubuntu
WorkingDirectory=/opt/remindcare
EnvironmentFile=-/opt/remindcare/.env
ExecStart=/usr/bin/node scripts/backup-db.js
StandardOutput=journal
StandardError=journal
SyslogIdentifier=remindcare-backup