[Unit]
Description=pregnancy-reminder-bot watchdog (periksa denyut bot dari luar proses)
Documentation=file:/opt/remindcare/deploy/INSTALL.md
After=remindcare-bot.service
Wants=remindcare-bot.service

[Service]
Type=oneshot
# User dan WorkingDirectory harus sama dengan unit bot supaya berkas denyut bisa dibaca.
User=ubuntu
Group=ubuntu
WorkingDirectory=/opt/remindcare
EnvironmentFile=-/opt/remindcare/.env
Environment=NODE_ENV=production
ExecStart=/usr/bin/node /opt/remindcare/scripts/watchdog.js
# Penjaga hanya membaca berkas dan mengirim HTTP keluar.
ProtectSystem=strict
ProtectHome=read-only
PrivateTmp=true
NoNewPrivileges=true
ReadWritePaths=/opt/remindcare/data
StandardOutput=journal
StandardError=journal
SyslogIdentifier=remindcare-watchdog
