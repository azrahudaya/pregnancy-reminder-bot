# Salin file ini jadi .env lalu isi sesuai kebutuhan.
# Nilai di bawah adalah default yang dipakai kalau barisnya tidak ada.
# Bot menolak jalan kalau ada nilai angka yang salah tulis (lihat validateEnv di index.js).

# --- Waktu dan program ---
TIMEZONE=Asia/Jakarta
PREGNANCY_WEEKS_LIMIT=42
DELIVERY_VALIDATION_START_WEEK=39
REMINDER_LOG_RETENTION_DAYS=180
REMINDER_STALE_AFTER_MINUTES=30
MAX_SEND_ATTEMPTS=4

# --- Keamanan pengiriman (dipakai lib/send-guard.js) ---
# Jeda acak antar pesan. Jangan turunkan di bawah 1500 ms.
SEND_MIN_GAP_MS=3500
SEND_JITTER_MS=2500
REPLY_MIN_GAP_MS=900
REPLY_JITTER_MS=1200
# Kuota keluar global. Inilah rem yang mencegah pola broadcast.
SEND_MAX_PER_MINUTE=12
SEND_MAX_PER_HOUR=180
SEND_MAX_PER_DAY=900
SEND_MAX_QUEUE_WAIT_MS=900000
# Circuit breaker: berhenti mengirim setelah sekian kegagalan permanen berturut-turut.
SEND_FAIL_BREAKER=5
SEND_PAUSE_MS=3600000
# Jendela jam kirim untuk pengingat terjadwal (balasan percakapan tidak dibatasi).
SEND_WINDOW_START_HOUR=6
SEND_WINDOW_END_HOUR=21
SEND_WINDOW_END_MINUTE=30
# Kurva warm-up sesi baru: kuota harian lebih kecil pada 30 hari pertama.
SEND_WARMUP_ENABLED=1
SEND_WARMUP_DAY1_MAX=50
SEND_WARMUP_DAY8_MAX=150

# --- WhatsApp Web (whatsapp-web.js) ---
# Jalur Chrome asli. Kosongkan supaya dicari otomatis.
PUPPETEER_EXECUTABLE_PATH=
# Nama dan id sesi. clientId memisahkan direktori sesi, jangan diubah setelah dipakai.
WA_CLIENT_ID=remindcare
WA_DEVICE_NAME=RemindCare
WA_INIT_MAX_ATTEMPTS=10
# Nomor bot untuk penautan tanpa QR, format 628xxxxxxxxxx. Kosongkan untuk pakai QR.
# Kalau diisi, kode 8 digit muncul di journal dan di data/pairing-code.txt.
WA_PAIRING_NUMBER=
# Interval permintaan kode pairing baru selama belum tersambung (milidetik).
WA_PAIRING_CODE_REFRESH_MS=180000
# Set 1 kalau dijalankan sebagai root atau di dalam container tanpa sandbox.
PUPPETEER_NO_SANDBOX=0
DISABLE_CHROME_SANDBOX=0

# --- Admin WA dan akses ---
ADMIN_WA_IDS=
ALLOWLIST_WA_IDS=
# Set 1 supaya hanya nomor di allowlist yang dilayani.
ENFORCE_ALLOWLIST=1

# --- Batas pesan masuk per user (anti spam dari luar) ---
RATE_LIMIT_MAX_PER_MINUTE=20
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_COOLDOWN_MS=120000
POLL_MAX_RESPONSES_PER_DAY=2
POLL_RETRY_BASE_DELAY_MS=300000
POLL_RETRY_MAX_DELAY_MS=1800000

# --- Loop pengingat ---
REMINDER_LOOP_CONCURRENCY=1

# --- Admin web ---
ADMIN_WEB_ENABLED=1
# Biarkan 127.0.0.1 kalau tidak ada reverse proxy TLS. Isi 0.0.0.0 hanya di balik proxy.
ADMIN_WEB_HOST=127.0.0.1
ADMIN_WEB_PORT=3030
ADMIN_WEB_USER=admin
# Kalau dikosongkan, bot membuat password acak dan menyimpannya di data/admin_web_password.txt (mode 600).
ADMIN_WEB_PASSWORD=
ADMIN_WEB_SESSION_TTL_MS=28800000
# Set 1 kalau admin web berada di belakang reverse proxy, supaya IP asli dipakai untuk rate limit login.
ADMIN_WEB_TRUST_PROXY=0
ADMIN_WEB_COOKIE_SECURE=0
ADMIN_LOGIN_MAX_ATTEMPTS=5
ADMIN_LOGIN_WINDOW_MS=900000

# --- Kelas ibu ---
MOTHER_CLASS_BASE_URL=https://remindcares.web.app
MOTHER_CLASS_WINDOW_START_HOUR=9
MOTHER_CLASS_WINDOW_END_HOUR=12

# --- Backup harian (dipakai scripts/backup-db.js) ---
BACKUP_KEEP_DAYS=14